# cronlens needs no secrets, API keys or network access.
# These optional variables mirror command-line options; flags take precedence.
# Copy to .env only if your tooling loads it; .env is git-ignored.

# Settings file to use instead of searching for cronlens.toml / pyproject.toml.
# CRONLENS_CONFIG=./cronlens.toml

# Zone assumed for crontabs without CRON_TZ= and CronJobs without spec.timeZone.
# CRONLENS_DEFAULT_TZ=Europe/London

# Lowest severity that makes `cronlens scan` exit with status 1:
# error, warning, info or never.
# CRONLENS_FAIL_ON=warning
